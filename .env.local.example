# Copy this file to `.env.local` and fill in DB_CONNECT.
# (`.env.local` is git-ignored — never commit real credentials.)

# REQUIRED — MongoDB connection string. Only read server-side (lib/db.ts) to
# render Tidbits / Slides / the homepage tidbits row. Without it, those
# DB-backed pages error at request time; lessons / demos / blog still work.
DB_CONNECT=mongodb+srv://user:pass@cluster.mongodb.net/frontend-ro

# OPTIONAL — public config. These already have production defaults baked into
# next.config.js, so you only need to set them to override locally.
# APP_ENV=development
# APP_URL=http://localhost:3000
# ENDPOINT=/api
# CLOUDFRONT_PUBLIC=https://d3tycb976jpudc.cloudfront.net
# LANGUAGE=ro
